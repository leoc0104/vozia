# --- required ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres   # local: `supabase start`; hosted: the session pooler URL
NODE_ENV=development                                                  # production switches every driver default to its real implementation

# --- pipeline & drivers (defaults: staged + all fake outside production) ---
VOZIA_PIPELINE=staged                 # staged | elevenlabs
VOZIA_INGESTOR_DRIVER=fake            # fake | ytdlp
VOZIA_SEPARATOR_DRIVER=fake           # fake | ffmpeg-duck | replicate-demucs
VOZIA_TRANSCRIBER_DRIVER=fake         # fake | elevenlabs
VOZIA_TRANSLATOR_DRIVER=fake          # fake | anthropic
VOZIA_SYNTHESIZER_DRIVER=fake         # fake | elevenlabs
VOZIA_MEDIA_DRIVER=fake               # fake | ffmpeg
VOZIA_STORAGE_DRIVER=fake             # fake | supabase

# --- Supabase (storage driver = supabase) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- providers ---
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
VOZIA_TRANSLATION_MODEL=claude-opus-5
REPLICATE_API_TOKEN=
# Version hash of a two-stem Demucs model on Replicate. Keep comments off lines with empty values:
# docker compose's env_file reads `KEY=   # note` as the value "# note".
REPLICATE_DEMUCS_VERSION=

# --- tuning ---
VOZIA_WORKER_CONCURRENCY=1
VOZIA_POLL_MS=2000
VOZIA_VISIBILITY_TIMEOUT_S=120
VOZIA_HEARTBEAT_MS=30000
VOZIA_MAX_ATTEMPTS=2
VOZIA_STAGE_TIMEOUT_MS=1800000
VOZIA_WORKDIR=
VOZIA_FAKE_STORAGE_DIR=
VOZIA_FFMPEG_PATH=ffmpeg
VOZIA_FFPROBE_PATH=ffprobe
VOZIA_YTDLP_PATH=yt-dlp
LOG_LEVEL=info
