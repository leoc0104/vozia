{
  "name": "@vozia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vozia/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "oxlint": "^1.83.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
